. ZGET2/JCL - put the LS-DOS built by zmac-build on :2. Run by ZGET2.BAT, with the FreHD directory zmac-build/out/floppy:.   :0 = L631BOOT_631A.DSK (LS-DOS 6.3.1A build system boot disk).   :1 = L631UTL2.DSK.   :2 = L631NEW2.DSK, a new copy of l2-631a.dmk: gets the new system.   :3 = a blank disk for the imported files. The copies are those of GETNEW/JCL and GETUTILS/JCL.format :3 (N="ZMACBIN",M="PASSWORD",DDEN,SIDES=2,STEP=2)import2 lowcore.cim lowcore/cim:3import2 sys0.cmd sys0/cmd:3import2 sys1.cmd sys1/cmd:3import2 sys2.cmd sys2/cmd:3import2 sys3.cmd sys3/cmd:3import2 sys4.cmd sys4/cmd:3import2 sys5.cmd sys5/cmd:3import2 sys6.cmd sys6/cmd:3import2 sys7.cmd sys7/cmd:3import2 sys8.cmd sys8/cmd:3import2 sys9.cmd sys9/cmd:3import2 sys10.cmd sys10/cmd:3import2 sys11.cmd sys11/cmd:3import2 sys12.cmd sys12/cmd:3import2 sys13.cmd sys13/cmd:3import2 backup.cmd backup/cmd:3import2 click.flt click/flt:3import2 com.dvr com/dvr:3import2 comm.cmd comm/cmd:3import2 conv.cmd conv/cmd:3import2 dateconv.cmd dateconv/cmd:3import2 floppy.dct floppy/dct:3import2 format.cmd format/cmd:3import2 forms.flt forms/flt:3import2 help.cmd help/cmd:3import2 ksm.flt ksm/flt:3import2 log.cmd log/cmd:3import2 memdisk.dct memdisk/dct:3import2 patch.cmd patch/cmd:3import2 repair.cmd repair/cmd:3time 06:31copy sys0/cmd:3 sys0/sys.system6:2 (c=n)copy sys1/cmd:3 sys1/sys.system6:2 (c=n)copy sys2/cmd:3 sys2/sys.system6:2 (c=n)copy sys3/cmd:3 sys3/sys.system6:2 (c=n)copy sys4/cmd:3 sys4/sys.system6:2 (c=n)copy sys5/cmd:3 sys5/sys.system6:2 (c=n)copy sys6/cmd:3 sys6/sys.system6:2 (c=n)copy sys7/cmd:3 sys7/sys.system6:2 (c=n)copy sys8/cmd:3 sys8/sys.system6:2 (c=n)copy sys9/cmd:3 sys9/sys.system6:2 (c=n)copy sys10/cmd:3 sys10/sys.system6:2 (c=n)copy sys11/cmd:3 sys11/sys.system6:2 (c=n)copy sys12/cmd:3 sys12/sys.system6:2 (c=n)copy sys13/cmd:3 sys13/sys.system6:2 (c=n)copy lowcore/cim:3 boot/sys.system6:2 (c=n)copy backup/cmd:3 backup/cmd.utility:2 (c=n)copy click/flt:3 click/flt.filter:2 (c=n)copy com/dvr:3 com/dvr.driver:2 (c=n)copy comm/cmd:3 comm/cmd.utility:2 (c=n)copy conv/cmd:3 conv/cmd.utility:2 (c=n)copy dateconv/cmd:3 dateconv/cmd.utility:2 (c=n)copy floppy/dct:3 floppy/dct.utility:2 (c=n)copy format/cmd:3 format/cmd.utility:2 (c=n)copy forms/flt:3 forms/flt.filter:2 (c=n)copy help/cmd:3 help/cmd.utility:2 (c=n)copy ksm/flt:3 ksm/flt.filter:2 (c=n)copy log/cmd:3 log/cmd.utility:2 (c=n)copy memdisk/dct:3 memdisk/dct.utility:2 (c=n)copy patch/cmd:3 patch/cmd.utility:2 (c=n)copy repair/cmd:3 repair/cmd.utility:2 (c=n)time 00.00dir /sys:2 (s). Job done